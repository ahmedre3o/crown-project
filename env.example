# API base URL (no trailing slash) - used by frontend to reach backend
# Vercel: set NEXT_PUBLIC_API_BASE_URL in Project → Settings → Environment Variables
#
# Local dev (backend on same machine):
#   NEXT_PUBLIC_API_BASE_URL=http://localhost:5001
#
# Production (Vercel):
#   NEXT_PUBLIC_API_BASE_URL=https://crown-api-756273570281.us-central1.run.app
#
# Note: Code also accepts NEXT_PUBLIC_API_URL as fallback.
NEXT_PUBLIC_API_BASE_URL=
