# API base URL (no trailing slash)
#
# Local dev (backend on same machine):
#   NEXT_PUBLIC_API_BASE_URL=http://localhost:5001
#
# Local dev (use deployed Cloud Run backend):
#   NEXT_PUBLIC_API_BASE_URL=https://crown-api-756273570281.us-central1.run.app
#
# Production (Cloud Run) - set at build time in Docker/Cloud Build:
#   NEXT_PUBLIC_API_BASE_URL=https://crown-api-756273570281.us-central1.run.app
#
# Copy to .env.local and fill:
NEXT_PUBLIC_API_BASE_URL=
