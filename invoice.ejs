<!-- views/partials/invoice.ejs -->
<div class="invoice-design">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="orbitron-font">CROWN SERVICES</h2>
            <p>تاج الخدمات</p>
        </div>
        <div>
            <h4>فاتورة رقم: #<%= invoice.id %></h4>
            <p>التاريخ: <%= new Date(invoice.date).toLocaleDateString('ar-EG') %></p>
        </div>
    </div>
    <hr>
    <h5>العميل: <%= invoice.customerName %></h5>
    <table class="table table-bordered mt-4">
        <thead>
            <tr>
                <th>الصنف</th>
                <th>الكمية</th>
                <th>السعر</th>
                <th>الإجمالي</th>
            </tr>
        </thead>
        <tbody>
            <% invoice.items.forEach(item => { %>
            <tr>
                <td><%= item.name %></td>
                <td><%= item.quantity %></td>
                <td><%= item.price.toLocaleString() %> ج.م</td>
                <td><%= (item.quantity * item.price).toLocaleString() %> ج.م</td>
            </tr>
            <% }) %>
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3" class="text-end">الإجمالي النهائي:</th>
                <th><%= invoice.total.toLocaleString() %> ج.م</th>
            </tr>
        </tfoot>
    </table>
    <p class="text-center mt-4">شكراً لتعاملكم معنا</p>
</div>